{% assign wl = trmnl.plugin_settings.custom_fields_values.wl_lines | default: "" %}
{% assign monitored_lines = wl | remove: " " | split: "," %}

{% assign wl_ex = trmnl.plugin_settings.custom_fields_values.wl_exclude | default: "" | downcase %}
{% assign excluded_keywords = wl_ex | split: "," %}

{% assign max_age_days = trmnl.plugin_settings.custom_fields_values.wl_max_age | default: 0 | times: 1 %}
{% assign clock = message.serverTime | default: "now" %}
{% assign now_epoch = clock | date: "%s" | times: 1 %}

{% assign sort_mode = trmnl.plugin_settings.custom_fields_values.wl_sort | default: "time" %}

{% assign compact_mode = trmnl.plugin_settings.custom_fields_values.wl_compact | default: "off" %}
{% if compact_mode == true or compact_mode == "true" %}{% assign compact_mode = "all" %}{% endif %}
{% assign compact = false %}

{% capture keys -%}
{%- for t in data.trafficInfos -%}
  {%- if t.status == "active" -%}
    {%- capture is_hidden -%}
      {%- assign haystack = t.title | append: " " | append: t.description | downcase -%}
      {%- for w in excluded_keywords -%}
        {%- assign kw = w | strip -%}
        {%- if kw != "" and haystack contains kw -%}1{%- endif -%}
      {%- endfor -%}
      {%- if max_age_days > 0 and t.time.start -%}
        {%- assign start_epoch = t.time.start | date: "%s" | times: 1 -%}
        {%- assign age_days = now_epoch | minus: start_epoch | divided_by: 86400 -%}
        {%- if age_days > max_age_days -%}1{%- endif -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- unless is_hidden contains "1" -%}
      {%- if sort_mode == "lines" -%}
        {%- assign line_rank = 99 -%}
        {%- for line in t.relatedLines -%}
          {%- for ml in monitored_lines -%}
            {%- if ml == line and forloop.index0 < line_rank -%}{%- assign line_rank = forloop.index0 -%}{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- assign sort_epoch = 0 -%}
        {%- if t.time.start -%}{%- assign sort_epoch = t.time.start | date: "%s" | times: 1 -%}{%- endif -%}
        {%- assign inv_epoch = 9999999999 | minus: sort_epoch -%}
        {%- if line_rank < 10 -%}0{%- endif -%}{{ line_rank }}|{{ inv_epoch }}|{{ t.name }}||
      {%- else -%}
        {%- if t.time and t.time.start -%}{{ t.time.start }}{%- else -%}0000-00-00T00:00:00.000+0000{%- endif -%}|{{ t.name }}||
      {%- endif -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- endcapture %}
{%- if sort_mode == "lines" -%}{%- assign keys = keys | split: "||" | sort -%}{%- else -%}{%- assign keys = keys | split: "||" | sort | reverse -%}{%- endif -%}

{% capture any_flag -%}
{%- for t in data.trafficInfos -%}
  {%- if t.status == "active" -%}
    {%- capture is_hidden -%}
      {%- assign haystack = t.title | append: " " | append: t.description | downcase -%}
      {%- for w in excluded_keywords -%}
        {%- assign kw = w | strip -%}
        {%- if kw != "" and haystack contains kw -%}1{%- endif -%}
      {%- endfor -%}
      {%- if max_age_days > 0 and t.time.start -%}
        {%- assign start_epoch = t.time.start | date: "%s" | times: 1 -%}
        {%- assign age_days = now_epoch | minus: start_epoch | divided_by: 86400 -%}
        {%- if age_days > max_age_days -%}1{%- endif -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- unless is_hidden contains "1" -%}
      {%- for line in t.relatedLines -%}
        {%- if monitored_lines contains line -%}1{%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- endcapture %}
{% assign any_flag = any_flag | strip %}

{% if compact_mode == "all" %}{% assign compact = true %}{% endif %}

<div class="layout layout--col layout--stretch">
  {% if any_flag contains "1" %}

    <div class="columns" data-overflow-max-cols="1" data-overflow-counter="true">
      <div class="column">

        {% for k in keys %}
          {% if k contains "|" %}
            {% assign info_name = k | split: "|" | last %}
            {% for t in data.trafficInfos %}
              {% if t.status == "active" and t.name == info_name %}

                {% capture is_relevant %}{% for line in t.relatedLines %}{% if monitored_lines contains line %}1{% endif %}{% endfor %}{% endcapture %}
                {% assign is_relevant = is_relevant | strip %}

                {%- capture is_hidden -%}
                  {%- assign haystack = t.title | append: " " | append: t.description | downcase -%}
                  {%- for w in excluded_keywords -%}
                    {%- assign kw = w | strip -%}
                    {%- if kw != "" and haystack contains kw -%}1{%- endif -%}
                  {%- endfor -%}
                  {%- if max_age_days > 0 and t.time.start -%}
                    {%- assign start_epoch = t.time.start | date: "%s" | times: 1 -%}
                    {%- assign age_days = now_epoch | minus: start_epoch | divided_by: 86400 -%}
                    {%- if age_days > max_age_days -%}1{%- endif -%}
                  {%- endif -%}
                {%- endcapture -%}
                {%- if is_hidden contains "1" -%}{%- assign is_relevant = "" -%}{%- endif -%}

                {% if is_relevant contains "1" %}

                  <div class="item item--emphasis-2">
                    <div class="meta"></div>
                    <div class="content">

                      <div class="flex gap--small flex--left flex--center-y">
                        {% for line in t.relatedLines %}
                          {% if monitored_lines contains line %}
                            <span class="label label--large lg:label--xlarge label--inverted">{{ line }}</span>
                          {% endif %}
                        {% endfor %}
                        <span class="title title--large lg:title--xxlarge"  data-clamp="1">{{ t.title | split: ": " | last }}</span>
                      </div>

                      {% unless compact %}
                      {% assign raw = t.description | replace: "Grund :", "Grund:" | strip %}

                      {% assign reason = "" %}
                      {% assign duration = "" %}
                      {% assign desc = raw %}

                      {%- if raw contains "Grund:" -%}
                        {% assign reason = raw | split: "Grund:" | last | strip %}
                        {%- assign reason_last = reason | slice: -1 -%}
                        {%- if reason_last == "." -%}
                          {%- assign reason_len = reason | size | minus: 1 -%}
                          {%- assign reason = reason | slice: 0, reason_len -%}
                        {%- endif -%}
                        {% assign desc = raw | split: "Grund:" | first | strip %}
                      {%- endif -%}

                      {%- if desc contains "Voraussichtliche Dauer:" -%}
                        {% assign duration = desc | split: "Voraussichtliche Dauer:" | last | strip %}
                        {% assign duration = duration | remove: "." | strip %}
                        {% assign desc     = desc | split: "Voraussichtliche Dauer:" | first | strip %}
                      {%- endif -%}

                      {%- assign desc_head = desc | slice: 0, 5 -%}
                      {%- if desc_head == "Linie" and desc contains ":" -%}
                        {% assign parts = desc | split: ":" %}
                        {% capture rest %}{% for p in parts %}{% if forloop.index0 > 0 %}{% if forloop.index0 > 1 %}:{% endif %}{{ p }}{% endif %}{% endfor %}{% endcapture %}
                        {% assign desc = rest | strip %}
                      {%- endif -%}

                      {% if duration != "" %}
                        <span class="description description--large lg:description--xlarge text--gray-50" data-clamp="1">
                          Voraussichtliche Dauer: {{ duration }}
                        </span>
                      {% endif %}

                      <span class="description description--large lg:description--xlarge" data-clamp="1" data-clamp-md="3">{{ desc }}</span>

                      {% if reason != "" %}
                        <span class="description description--large lg:description-xlarge text--gray-50" data-clamp="1" data-clamp-md="1">
                          Grund: {{ reason }}
                        </span>
                      {% endif %}

                      {% endunless %}

                      {% if t.time.start %}
                        <div class="flex gap--small">
                          <span class="label label--small lg:label--base">
                            Seit {{ t.time.start | date: "%H:%M" }}
                          </span>
                        </div>
                      {% endif %}

                    </div>
                  </div>

                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}

      </div>
    </div>

  {% else %}

    <div class="flex flex--col flex--center flex--center-x gap">
      <span class="value value--xxxlarge lg:value--peta">✓</span>
      <span class="label label--xlarge lg:label--xxlarge">Keine Störungen</span>
      <span class="description description--large lg:description--xlarge text--gray-50 text--center">
        {{ monitored_lines | join: " · " }} fahren planmäßig
      </span>
    </div>

  {% endif %}
</div>

<div class="title_bar">
  <img
    class="image image-dither image-stroke--base"
    alt="Wiener Linien"
    src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/24/Wiener_Linien_Icon.svg/250px-Wiener_Linien_Icon.svg.png"
  />
  <span class="title">Wiener Linien-Störungen</span>
  <span class="instance">Zuletzt aktualisiert: {{ message.serverTime | date: "%H:%M" }}</span>
</div>
