{% if compact_mode == "all" or compact_mode == "small" %}{% assign compact = true %}{% endif %}

<div class="layout layout--col layout--stretch">
  {% if any_flag contains "1" %}

    <div class="columns" data-overflow-max-cols="1" data-overflow-counter="true">
      <div class="column">

        {% for k in keys %}
          {% if k contains "|" %}
            {% assign info_name = k | split: "|" | last %}
            {% for t in data.trafficInfos %}
              {% if t.status == "active" and t.name == info_name %}

                {% capture is_relevant %}{% for line in t.relatedLines %}{% if monitored_lines contains line %}1{% endif %}{% endfor %}{% endcapture %}
                {% assign is_relevant = is_relevant | strip %}

                {%- capture is_hidden -%}
                  {%- assign haystack = t.title | append: " " | append: t.description | downcase -%}
                  {%- for w in excluded_keywords -%}
                    {%- assign kw = w | strip -%}
                    {%- if kw != "" and haystack contains kw -%}1{%- endif -%}
                  {%- endfor -%}
                  {%- if max_age_days > 0 and t.time.start -%}
                    {%- assign start_epoch = t.time.start | date: "%s" | times: 1 -%}
                    {%- assign age_days = now_epoch | minus: start_epoch | divided_by: 86400 -%}
                    {%- if age_days > max_age_days -%}1{%- endif -%}
                  {%- endif -%}
                {%- endcapture -%}
                {%- if is_hidden contains "1" -%}{%- assign is_relevant = "" -%}{%- endif -%}

                {% if is_relevant contains "1" %}

                  <div class="item item--emphasis-2">
                    <div class="meta"></div>
                    <div class="content">

                      <div class="flex gap--small flex--left flex--center-y">
                        {% for line in t.relatedLines %}
                          {% if monitored_lines contains line %}
                            <span class="label label--large lg:label--xlarge label--inverted">{{ line }}</span>
                          {% endif %}
                        {% endfor %}
                        <span class="title title--large lg:title--xxlarge"  data-clamp="1">{{ t.title | split: ": " | last }}</span>
                      </div>

                      {% unless compact %}
                      {% comment %} Only the duration is shown in this view {% endcomment %}
                      {% assign raw = t.description | replace: "Grund :", "Grund:" | strip %}

                      {% assign duration = "" %}
                      {% assign desc = raw %}

                      {%- if raw contains "Grund:" -%}
                        {% assign desc = raw | split: "Grund:" | first | strip %}
                      {%- endif -%}

                      {%- if desc contains "Voraussichtliche Dauer:" -%}
                        {% assign duration = desc | split: "Voraussichtliche Dauer:" | last | strip %}
                        {% assign duration = duration | remove: "." | strip %}
                      {%- endif -%}

                      {% if duration != "" %}
                        <span class="description description--base lg:description--large text--gray-50 1bit:text--black">
                          Voraussichtliche Dauer:
                        </span>
                        <span class="description description--base lg:description--large text--gray-50 1bit:text--black wl-underline" data-clamp="2">
                          {{ duration }}
                        </span>
                      {% endif %}

                      {% endunless %}

                    </div>
                  </div>

                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}

      </div>
    </div>

  {% else %}

    <div class="flex flex--col flex--center flex--center-x gap">
      <span class="value value--large lg:value--xxxlarge">✓</span>
      <span class="label label--large lg:label--xxlarge">Keine Störungen</span>
      <div class="flex flex--col">
        <span class="description description--large lg:description--xlarge text--gray-50 1bit:text--black text--center">
          {{ monitored_lines | join: " · " }}
        </span>
        <span class="description description--large lg:description--xlarge text--gray-50 1bit:text--black text--center">
          fahren planmäßig
        </span>
      </div>
    </div>

  {% endif %}
</div>

<div class="title_bar">
  <img
    class="image image-dither image-stroke--base"
    alt="Wiener Linien"
    src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/24/Wiener_Linien_Icon.svg/250px-Wiener_Linien_Icon.svg.png"
  />
  <span class="instance">Zuletzt aktualisiert: {{ message.serverTime | date: "%H:%M" }}</span>
</div>
